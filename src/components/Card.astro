---
interface Props { href: string; title: string; description: string; tag?: string; meta?: string }
const { href, title, description, tag, meta } = Astro.props;
---
<a class="card" href={href}>
  {tag && <span class="tag">{tag}</span>}
  <h3>{title}</h3>
  <p>{description}</p>
  {meta && <span class="meta">{meta}</span>}
</a>
